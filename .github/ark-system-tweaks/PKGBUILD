pkgname=ark-system-tweaks
pkgver=1.0.0
pkgrel=22
pkgdesc="System configuration and tweaks for Ark Linux"
arch=('any')
license=('MIT' 'CC-BY-SA-3.0-US')
makedepends=('libheif' 'libjpeg-turbo')
# Keep the existing Ark artwork, but ship a JPEG that GNOME can load without
# interpreting the HEIC's unsupported CICP color-primary metadata.
_wallpaper_commit=f3c227ad7a6dc6c161f35d8783e966c8a423ed5c
source=(
  "grid.heic::https://raw.githubusercontent.com/zamkara/ark-backgrounds/${_wallpaper_commit}/backgrounds/grid.heic"
  "wallpaper-COPYING::https://raw.githubusercontent.com/zamkara/ark-backgrounds/${_wallpaper_commit}/COPYING"
  "wallpaper-AUTHORS::https://raw.githubusercontent.com/zamkara/ark-backgrounds/${_wallpaper_commit}/AUTHORS"
)
sha256sums=(
  'a2fb5da52e68377cd6e0f273ff4a8e78b559d92cbe69e1d6c9188d6cc1cfb220'
  '3631dc0829b5342781ec14cd9dfccb9a67554e2068332c16d31d68739ff98ed5'
  '69cd930d9ec403757b65965fdacb8fc7590361490151b80e29f2f641ba19e14a'
)

build() {
  heif-convert -q 95 "$srcdir/grid.heic" "$srcdir/grid.jpg"
}

package() {
  install -Dm644 "$srcdir/grid.jpg" "$pkgdir/usr/share/backgrounds/ark/grid.jpg"
  install -Dm644 "$srcdir/wallpaper-COPYING" "$pkgdir/usr/share/licenses/$pkgname/wallpaper-COPYING"
  install -Dm644 "$srcdir/wallpaper-AUTHORS" "$pkgdir/usr/share/licenses/$pkgname/wallpaper-AUTHORS"
  printf '%s\n' \
    "Source: https://github.com/zamkara/ark-backgrounds/tree/$_wallpaper_commit" \
    'Change: converted grid.heic to JPEG at quality 95 for GNOME compatibility.' \
    > "$pkgdir/usr/share/licenses/$pkgname/wallpaper-changes"
  # 1. OSTree prepare-root config
  install -Dm644 /dev/null "$pkgdir/etc/ostree/prepare-root.conf"
  printf '[sysroot]\ncomposefs=false\n' > "$pkgdir/etc/ostree/prepare-root.conf"

  # 2. System tweaks hook (for plymouth and os-release)
  install -Dm644 /dev/null "$pkgdir/usr/share/libalpm/hooks/99-ark-system-tweaks.hook"
  cat <<EOF > "$pkgdir/usr/share/libalpm/hooks/99-ark-system-tweaks.hook"
[Trigger]
Operation = Install
Operation = Upgrade
Type = Package
Target = filesystem
Target = plymouth
Target = ark-system-tweaks

[Action]
Description = Applying Ark Linux system tweaks...
When = PostTransaction
Exec = /usr/bin/bash -c "sed -i 's/Theme=spinner/Theme=bgrt/' /etc/plymouth/plymouthd.conf 2>/dev/null || true; sed -i 's/VERSION_ID=.*/VERSION_ID=\"rolling\"/' /usr/lib/os-release 2>/dev/null || true"
EOF

  # 3. Emergency service override
  install -Dm644 /dev/null "$pkgdir/etc/systemd/system/emergency.service.d/override.conf"
  echo -e "[Service]\nEnvironment=SYSTEMD_SULOGIN_FORCE=1" > "$pkgdir/etc/systemd/system/emergency.service.d/override.conf"

  # 4. Silent boot kargs
  install -Dm644 /dev/null "$pkgdir/usr/lib/bootc/kargs.d/01-silent-boot.toml"
  echo 'kargs = ["quiet", "splash", "loglevel=3", "rd.udev.log_priority=3", "vt.global_cursor_default=0", "boot.shell_on_fail=1"]' > "$pkgdir/usr/lib/bootc/kargs.d/01-silent-boot.toml"

  # 4b. Serial console kargs (QEMU/virt console)
  install -Dm644 /dev/null "$pkgdir/usr/lib/bootc/kargs.d/02-console-serial.toml"
  echo 'kargs = ["console=ttyS0,115200"]' > "$pkgdir/usr/lib/bootc/kargs.d/02-console-serial.toml"

  # 5. Sudoers wheel group
  install -Dm644 /dev/null "$pkgdir/etc/sudoers.d/10-ark-wheel"
  cat <<'EOF' > "$pkgdir/etc/sudoers.d/10-ark-wheel"
%wheel ALL=(ALL:ALL) NOPASSWD: ALL
EOF

  # 6. Polkit wheel rule
  install -Dm644 /dev/null "$pkgdir/etc/polkit-1/rules.d/10-ark-wheel.rules"
  cat <<'EOF' > "$pkgdir/etc/polkit-1/rules.d/10-ark-wheel.rules"
polkit.addRule(function(action, subject) {
  if (subject.isInGroup("wheel")) {
    return polkit.Result.YES;
  }
});
EOF

  # 7. GSchema override (theme + app folders)
  install -Dm644 /dev/null "$pkgdir/usr/share/glib-2.0/schemas/99-ark-theme.gschema.override"
  cat <<'EOF' > "$pkgdir/usr/share/glib-2.0/schemas/99-ark-theme.gschema.override"
[org.gnome.desktop.interface]
icon-theme='MoreWaita'

[org.gnome.desktop.background]
picture-uri='file:///usr/share/backgrounds/ark/grid.jpg'
picture-uri-dark='file:///usr/share/backgrounds/ark/grid.jpg'
picture-options='zoom'

[org.gnome.desktop.app-folders]
folder-children=['System', 'Utilities', 'Containers']

[org.gnome.desktop.app-folders.folder:/org/gnome/desktop/app-folders/folders/Containers/]
name='Containers'
translate=true
categories=['Distrobox']

[org.gnome.desktop.app-folders.folder:/org/gnome/desktop/app-folders/folders/System/]
name='System'
translate=true
apps=['org.gnome.Settings.desktop', 'com.zamkara.alga.desktop']

[org.gnome.desktop.app-folders.folder:/org/gnome/desktop/app-folders/folders/Utilities/]
name='Utilities'
translate=true
apps=['org.gnome.Console.desktop', 'com.ranfdev.DistroShelf.desktop', 'org.gnome.DejaDup.desktop', 'org.gnome.FileRoller.desktop', 'org.gnome.fonts.desktop', 'org.gnome.Loupe.desktop', 'org.gnome.seahorse.Application.desktop']
EOF
  # 8. bootupd symlinks
  install -d "$pkgdir/usr/bin"
  ln -s /usr/libexec/bootupd "$pkgdir/usr/bin/bootupd"

  # locale-archive is generated by locale-gen on the target image. Packaging
  # a localedef output directory at that path conflicts with glibc's archive.
}
